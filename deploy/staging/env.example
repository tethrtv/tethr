# Staging runs on its own box with its own tunnel and database, and no backups.
# Generate passwords with: openssl rand -hex 32
TUNNEL_TOKEN=
POSTGRES_PASSWORD=
STAGING_DB_PASSWORD=
# Staging's own Resend key, so staging can't use up production's mail.
STAGING_RESEND_API_KEY=
# TMDB's read access token, for episode lists and air dates.
TMDB_TOKEN=
