# Staging runs on its own box with its own tunnel and database.
# Generate passwords with: openssl rand -hex 32
TUNNEL_TOKEN=
POSTGRES_PASSWORD=
STAGING_DB_PASSWORD=
# Staging's own Resend key, so staging can't use up production's mail.
STAGING_RESEND_API_KEY=
# TMDB's read access token, for episode lists and air dates.
TMDB_TOKEN=
# A nightly pg_dump goes to its own R2 bucket, one file per weekday. Use a key that can only reach that bucket.
BACKUP_BUCKET=tethr-staging-backups
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# A check of its own, not production's, so a failing staging backup can't hide behind production's pings.
HEALTHCHECK_URL=
