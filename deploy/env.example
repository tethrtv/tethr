TETHR_DB_PASSWORD=
STAGING_DB_PASSWORD=
WALG_S3_PREFIX=s3://tethr-backups/postgres
WALG_LIBSODIUM_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RESEND_API_KEY=
# TMDB's read access token, for episode lists and air dates.
TMDB_TOKEN=
HEALTHCHECK_URL=
